# Token bot Telegram lay tu @BotFather (bat buoc). Dan token vao sau dau =, khong co dau cach.
TELEGRAM_BOT_TOKEN=

# ID so cua chu bot (KHUYEN DUNG, de trong la giu hanh vi cu). Lay bang cach mo @userinfobot
# tren Telegram, no tra ve 1 day so (vd 123456789) -- KHONG phai username @... Neu dat dong nay
# thi chi dung ID do moi la admin, ke ca khi co nguoi la gui /start truoc, va admin cu trong
# file state se khong con quyen nua. De trong neu muon nguoi dau tien gui /start lam admin.
TELEGRAM_ADMIN_ID=

# ---- Phan duoi day KHONG can sua ----
# Thu muc tam chua file tu Telegram truoc khi gui len Muse (tinh tu thu muc muse_telebot\).
MUSE_UPLOAD_DIR=..\Videos\downloads\muse_telebot
# FoxProfile chi chay tren may nay.
FOXPROFILE_API_HOST=127.0.0.1
FOXPROFILE_API_PORT=8000
FOXPROFILE_URL=http://127.0.0.1:8000
NO_PROXY=127.0.0.1,localhost
# Thu muc FoxProfile duoc phep upload (tinh tu foxprofile\data\).
FOXPROFILE_UPLOAD_DIRS=..\..\Videos\downloads
FOXPROFILE_API_TOKEN=
